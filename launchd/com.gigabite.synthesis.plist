<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. install.sh substitutes __DAILY_BIN__ / __LOG__ and installs a copy
     to ~/Library/LaunchAgents/com.gigabite.synthesis.plist. Runs the gated
     end-of-day synthesis + decay daily at 18:00. Nothing auto-applies. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gigabite.synthesis</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DAILY_BIN__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>18</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
