# gigabite — code only. No content, no secrets, ever.

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
build/
dist/

# macOS
.DS_Store

# Local stores live OUTSIDE the repo (~/.core, ~/.knowledge) by design.
# These patterns are belt-and-suspenders in case anything is ever created in-tree.
.core/
.knowledge/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# The drop folder is real content (meeting notes, client docs) staged in-tree.
# Ignore everything in it; keep only the instructions.
/Inbox/*
!/Inbox/README.md

# Any accidental content / exports / secrets
*.enc
conversations.json
/knowledge/
/core/
secrets*
*.key
*.pem

# ...but DO keep the scaffold templates (they contain no real content)
!install/scaffold/core.md

# Claude Code machine-local settings
.claude/settings.local.json
