<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Not installed by install.sh — Granola API access is not universal
     yet, so this is a separate, additive install path. Fill __DAILY_BIN__ /
     __LOG__ the same way install.sh does for com.gigabite.synthesis.plist, e.g.:
       sed -e "s|__DAILY_BIN__|$REPO/bin/gigabite-granola-pull|g" \
           -e "s|__LOG__|$HOME/Library/Logs/gigabite-granola-pull.log|g" \
           install/launchd/com.gigabite.granola-pull.plist \
           > ~/Library/LaunchAgents/com.gigabite.granola-pull.plist
     then load it yourself:
       launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/com.gigabite.granola-pull.plist
     Runs `gigabite granola-sync` daily at 19:00 — pulls every new Granola note
     (transcript + AI summary) via the public API and files it by project. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gigabite.granola-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DAILY_BIN__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>19</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
