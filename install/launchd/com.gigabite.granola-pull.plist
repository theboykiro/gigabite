<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Not installed by install.sh — Granola API access is not universal
     yet, so this is a separate, additive install path. Fill __DAILY_BIN__ /
     __LOG__ the way `gigabite integrations` does, e.g.:
       sed -e "s|__DAILY_BIN__|$REPO/bin/gigabite-granola-pull|g" \
           -e "s|__LOG__|$HOME/Library/Logs/gigabite-granola-pull.log|g" \
           install/launchd/com.gigabite.granola-pull.plist \
           > ~/Library/LaunchAgents/com.gigabite.granola-pull.plist
     then load it yourself:
       launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/com.gigabite.granola-pull.plist
     Runs `gigabite granola-sync` at 11:00 and 18:00 on weekdays — pulls every new
     Granola note (transcript + AI summary) via the public API and files it by
     project. Fires hourly; the bin script pulls once per slot, so a Mac asleep
     or offline at 11:00/18:00 catches up when it's back. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gigabite.granola-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DAILY_BIN__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
