<?xml version="1.0" encoding="UTF-8"?>
<!-- Template. Fill __DAILY_BIN__ / __LOG__ like the granola-pull plist. Runs the
     propose-only tidy nightly at 22:00 (a Mac asleep then runs it on wake).
     It never moves files; `gigabite tidy --apply` does. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gigabite.tidy</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DAILY_BIN__</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>22</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>
</dict>
</plist>
